generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Barbershop {
  id         Int          @id @default(autoincrement())
  name       String       @db.VarChar(60)
  email      String       @unique @db.VarChar(100)
  phone      String       @db.VarChar(15)
  logo       String?      @db.VarChar(255)
  address    String       @db.VarChar(200)
  intagram   String?       @db.VarChar(100)
  facebook   String?      @db.VarChar(100)
  password   String       @db.VarChar(255)
  
  Barber     Barber[]
  Service    Service[]
  Scheduling Scheduling[]
  WorkingHours WorkingHours[]
  ClosedDay  ClosedDay[]
  PushToken  PushToken[]
  BarbershopSettings BarbershopSettings[]
  @@map("barbershop")
}

model Barber {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(50)
  phone        String       @unique @db.VarChar(15)
  password     String       @db.VarChar(255)
  profile      String?      @db.VarChar(255)

  barbershopId Int
  barbershop   Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  Scheduling   Scheduling[]
  PushToken    PushToken[]
  @@map("barber")
}

model Client {
  id         Int          @id @default(autoincrement())
  name       String       @db.VarChar(60)
  phone      String       @db.VarChar(15)

  Scheduling Scheduling[]
  PushToken  PushToken[]
  @@map("client")
}
model Service {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(100)
  price        Float
  duration     Int          // duration in minutes
  description  String?      @db.VarChar(255)
  photo        String?      @db.VarChar(255)

  barbershopId Int
  barbershop   Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  SchedulingService SchedulingService[]
  @@map("service")
}
model Scheduling {
  id           Int          @id @default(autoincrement())
  date         DateTime     @db.Date
  time         DateTime     @db.Time(0)
  duaration    Int          // duration in minutes
  

  clientId     Int
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  barberId     Int
  barber       Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)

  barbershopId Int
  barbershop   Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  totalPrice   Float
  status       String       @db.VarChar(20) // e.g., "scheduled", "completed", "canceled"

  SchedulingService SchedulingService[]
  @@map("scheduling")
}
model SchedulingService {
  id           Int          @id @default(autoincrement())
  schedulingId Int
  serviceId    Int

  scheduling   Scheduling   @relation(fields: [schedulingId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("scheduling_service")
}
model WorkingHours {
  id           Int          @id @default(autoincrement())
  dayOfWeek    Int          // 0 (Sunday) to 6 (Saturday)
  openTime     DateTime     @db.Time(0) // e.g., "09:00"
  closeTime    DateTime     @db.Time(0) // e.g., "18:00"
  startLunch   DateTime?    @db.Time(0) // e.g., "12:00"
  endLunch     DateTime?    @db.Time(0) // e.g., "13:00"

  barbershopId Int
  barbershop   Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  lunch        Boolean      @default(false)

  @@map("working_hours")
}
model ClosedDay {
  id           Int          @id @default(autoincrement())
  date         DateTime     @db.Date
  reason       String?      @db.VarChar(255)

  barbershopId Int
  barbershop   Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@map("closed_day")
}
model PushToken {
  id           Int          @id @default(autoincrement())
  userType     String       @db.VarChar(20) // "barber" or "client"

  barberId     Int
  barber       Barber?      @relation(fields: [barberId], references: [id], onDelete: Cascade)

  clientId     Int
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  barbershopId Int
  barbershop   Barbershop?  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  token        String       @db.VarChar(255)

  @@map("push_token")
}
model BarbershopSettings {
  id                Int        @id @default(autoincrement())
  autoConfirm       Boolean    @default(false)
  reminderTime      Int        @default(60) // in minutes before appointment
  notifyClient      Boolean    @default(true)
  notifyBarber      Boolean    @default(true)

  barbershopId      Int
  barbershop        Barbershop?  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@map("barbershop_settings")
}